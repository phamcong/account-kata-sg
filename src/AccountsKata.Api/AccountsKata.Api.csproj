  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AccountsKata.Core\AccountsKata.Core.csproj" />
  </ItemGroup>

</Project>
